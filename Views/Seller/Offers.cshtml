@model List<OfferDisplayViewModel>
@using Evimsensin.Models
@{
    ViewData["Title"] = "Tekliflerim";
}

<section class="panel reveal-on-scroll">
    <div class="section-head slim">
        <h2>Tekliflerim</h2>
        <p>Ilanlariniza gelen tum teklif ve kiralama talepleri.</p>
    </div>

    <div class="offers-table-wrap">
        <table class="lux-table">
            <thead>
                <tr>
                    <th>Ilan</th>
                    <th>Tip</th>
                    <th>Gonderen</th>
                    <th>Tutar</th>
                    <th>Durum</th>
                    <th>Not</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.ListingTitle</td>
                    <td>@(o.Type == OfferType.RentalRequest ? "Kiralama" : "Fiyat")</td>
                    <td>@o.FromUserName</td>
                    <td>@o.Amount.ToString("N0") TL</td>
                    <td>
                        @if (o.Status == OfferStatus.Pending)
                        {
                            <span class="status-live">Beklemede</span>
                        }
                        else if (o.Status == OfferStatus.Accepted)
                        {
                            <span class="status-accepted">Kabul</span>
                        }
                        else
                        {
                            <span class="status-rejected">Reddedildi</span>
                        }
                    </td>
                    <td>@o.Note</td>
                    <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
