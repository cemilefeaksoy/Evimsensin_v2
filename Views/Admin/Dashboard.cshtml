@model List<Listing>
@{ ViewData["Title"] = "Admin Panel"; }
<section class="panel reveal-on-scroll">
    <h2>Admin Dashboard</h2>
    <p>Toplam ilan: @ViewBag.TotalListings</p>
    <p>Admin olarak tum satci/kullanici ilanlarini duzenleyebilir, silebilir ve admin onerisi verebilirsiniz.</p>
</section>
<section class="grid-cards">
@foreach (var item in Model)
{
    <article class="card-premium tilt-card reveal-on-scroll">
        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
        <div>
            <h3>@item.Title</h3>
            <p>@item.City</p>
            <p class="owner-pill">Ilan Sahibi: @item.OwnerName</p>
            <a asp-controller="Listings" asp-action="Edit" asp-route-id="@item.Id">Yonet</a>
        </div>
    </article>
}
</section>
