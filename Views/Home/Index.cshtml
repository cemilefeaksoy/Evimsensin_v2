@model List<Listing>
@{
    ViewData["Title"] = "Ana Sayfa";
    var featured = Model.Take(3).ToList();
    var luxury = Model.Skip(3).Take(3).ToList();
}

<section class="estate-hero reveal-on-scroll" data-parallax-container>
    <img src="~/img/lux-hero.png" alt="Premium villa" class="estate-hero-bg" data-parallax="0.12" />
    <div class="estate-hero-overlay"></div>

    <div class="estate-hero-content">
        <span class="hero-kicker">SECKIN YASAM KOLEKSIYONU</span>
        <h1>Mukemmelligin Yeni Adresi.</h1>
        <p>Dunyanin en seckin konumlarinda, sadece size ozel premium yasam alanlari.</p>
        <div class="hero-actions">
            <a class="btn-lux" asp-controller="Listings" asp-action="Index">Portfoyu Kesfet</a>
            <a class="btn-lux btn-ghost" asp-controller="Listings" asp-action="Create">Ilan Ver</a>
        </div>
    </div>

    <div class="hero-bottom-cards reveal-on-scroll">
        @foreach (var item in featured)
        {
            <article class="hero-mini-card tilt-card">
                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
                <div>
                    <h3>@item.Title</h3>
                    <p>@item.Province / @item.District · @item.MonthlyPrice.ToString("N0") TL</p>
                    <a asp-controller="Listings" asp-action="Details" asp-route-id="@item.Id">Goruntule</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="section-head reveal-on-scroll">
    <h2>Seckin Portfoyumuz</h2>
    <p>Admin oneri yildizli ilanlar ve guvenli kiralama deneyimi.</p>
</section>

<section class="portfolio-grid">
@foreach (var item in luxury)
{
    <article class="portfolio-card reveal-on-scroll tilt-card">
        <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />
        <div class="portfolio-body">
            <h3>
                @item.Title
                @if (item.IsAdminRecommended)
                {
                    <span class="badge-star">★ Admin Oneri</span>
                }
            </h3>
            <p>@item.PropertyType · @item.RoomCount · @item.NetSquareMeters m²</p>
            <p class="owner-pill">Ilan Sahibi: @item.OwnerName</p>
            <div class="portfolio-foot">
                <strong>@item.MonthlyPrice.ToString("N0") TL/ay</strong>
                <a asp-controller="Listings" asp-action="Details" asp-route-id="@item.Id" class="btn-lux btn-thin">Detay</a>
            </div>
        </div>
    </article>
}
</section>

<section class="lifestyle-grid reveal-on-scroll">
    <article class="lifestyle-box">
        <h3>Yasam Tarzi</h3>
        <p>Deniz manzarasi, residence konforu, akilli ev ve prestijli komsuluk secenekleri.</p>
    </article>
    <article class="lifestyle-box">
        <h3>Guvenli Islem</h3>
        <p>Teklif verme, kiralama, mesajlasma ve yorum akisinin tumu tek platformda.</p>
    </article>
    <article class="lifestyle-box">
        <h3>Satıcı Paneli</h3>
        <p>Gosterge paneli ile hangi ilanin kiralandigi, teklifler ve donusum oranlarini takip edin.</p>
    </article>
</section>
