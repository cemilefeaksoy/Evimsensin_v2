@model ListingDetailsViewModel
@{
    ViewData["Title"] = "Ilan Detay";
    var listingStars = Math.Clamp((int)Math.Round(Model.ListingRatingAverage, MidpointRounding.AwayFromZero), 0, 5);
    var sellerStars = Math.Clamp((int)Math.Round(Model.SellerRatingAverage, MidpointRounding.AwayFromZero), 0, 5);
    var mapQuery = Uri.EscapeDataString($"{Model.Listing.District}, Turkiye");
    var mapUrl = $"https://www.google.com/maps?q={mapQuery}&output=embed";
}

@if (TempData["Success"] is string success && !string.IsNullOrWhiteSpace(success))
{
    <section class="panel toast-inline success">@success</section>
}
@if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
{
    <section class="panel toast-inline danger">@error</section>
}

<section class="detail-wrap reveal-on-scroll">
    <div class="detail-image-wrap listing-gallery" data-gallery>
        @for (var i = 0; i < Model.GalleryImages.Count; i++)
        {
            var img = Model.GalleryImages[i];
            <a href="@img" target="_blank" rel="noreferrer" class="gallery-slide @(i == 0 ? "active" : "")" data-slide>
                <img src="@img" alt="@Model.Listing.Title" class="detail-image" />
            </a>
        }
        @if (Model.GalleryImages.Count > 1)
        {
            <button type="button" class="gallery-arrow left" data-gallery-prev aria-label="Onceki fotograf">‹</button>
            <button type="button" class="gallery-arrow right" data-gallery-next aria-label="Sonraki fotograf">›</button>
            <div class="gallery-dots">
                @for (var i = 0; i < Model.GalleryImages.Count; i++)
                {
                    <button type="button" class="gallery-dot @(i == 0 ? "active" : "")" data-gallery-dot data-index="@i" aria-label="Fotograf @(i + 1)"></button>
                }
            </div>
        }
        @if (Model.Listing.IsRented)
        {
            <span class="rented-overlay">KIRALANDI</span>
        }
    </div>

    <div class="panel detail-luxury-panel">
        <h2>@Model.Listing.Title @if (Model.Listing.IsAdminRecommended) { <span class="badge-star">★ Admin Oneri</span> }</h2>
        <p>@Model.Listing.Description</p>

        <div class="detail-price">@Model.Listing.MonthlyPrice.ToString("N0") TL</div>
        <p class="owner-pill">
            Ilan Puani:
            <span class="rating-stars">
                @for (var i = 1; i <= 5; i++)
                {
                    <span class="rating-star @(i <= listingStars ? "filled" : "")">★</span>
                }
            </span>
            @Model.ListingRatingAverage.ToString("0.0") / 5 (@Model.ListingRatingCount puan)
        </p>
        <p class="owner-pill">
            Ilan Sahibi:
            <a asp-controller="Profiles" asp-action="Seller" asp-route-id="@Model.Listing.OwnerUserId">@Model.Listing.OwnerName</a>
        </p>
        <p class="owner-pill">
            Satici Telefon:
            <strong>@(string.IsNullOrWhiteSpace(Model.OwnerUser?.PhoneNumber) ? "-" : Model.OwnerUser!.PhoneNumber)</strong>
        </p>
        <p class="owner-pill">
            Satici Puani:
            <span class="rating-stars">
                @for (var i = 1; i <= 5; i++)
                {
                    <span class="rating-star @(i <= sellerStars ? "filled" : "")">★</span>
                }
            </span>
            @Model.SellerRatingAverage.ToString("0.0") / 5 (@Model.SellerRatingCount puan)
        </p>

        <div class="feature-grid">
            <div><strong>Il / Ilce</strong><span>@Model.Listing.Province / @Model.Listing.District</span></div>
            <div><strong>Ilan Tipi</strong><span>@Model.Listing.ListingPurpose</span></div>
            <div><strong>Emlak Tipi</strong><span>@Model.Listing.PropertyType</span></div>
            <div><strong>Oda</strong><span>@Model.Listing.RoomCount</span></div>
            <div><strong>Brut/Net</strong><span>@Model.Listing.GrossSquareMeters m² / @Model.Listing.NetSquareMeters m²</span></div>
            <div><strong>Kat</strong><span>@Model.Listing.Floor / @Model.Listing.TotalFloors</span></div>
            <div><strong>Bina Yasi</strong><span>@Model.Listing.BuildingAge</span></div>
            <div><strong>Banyo</strong><span>@Model.Listing.BathroomCount</span></div>
            <div><strong>Isinma</strong><span>@Model.Listing.HeatingType</span></div>
            <div><strong>Depozito</strong><span>@Model.Listing.Deposit.ToString("N0") TL</span></div>
            <div><strong>Aidat</strong><span>@Model.Listing.Dues.ToString("N0") TL</span></div>
        </div>

        <div class="amenity-row">
            @if (Model.Listing.Furnished) { <span>Esyali</span> }
            @if (Model.Listing.Balcony) { <span>Balkon</span> }
            @if (Model.Listing.Elevator) { <span>Asansor</span> }
            @if (Model.Listing.Parking) { <span>Otopark</span> }
            @if (Model.Listing.InSite) { <span>Site</span> }
            @if (Model.Listing.HasPool) { <span>Havuz</span> }
            @if (Model.Listing.IsRented) { <span class="status-rented">Kiralandi</span> }
        </div>

        <div class="detail-cta-row">
            @if (Model.CanRent)
            {
                <a class="btn-glow" asp-controller="Rentals" asp-action="Payment" asp-route-listingId="@Model.Listing.Id">Ilani Kirala</a>
            }
            @if (Model.CanOffer)
            {
                <a class="btn-chat" href="#offerBox">Teklif Ver</a>
                <a class="btn-chat" asp-controller="Messages" asp-action="Chat" asp-route-withUserId="@Model.Listing.OwnerUserId">Saticiya Mesaj At</a>
            }
            @if (Model.IsAdmin)
            {
                <form asp-action="ToggleDailyRecommendation" method="post">
                    <input type="hidden" name="id" value="@Model.Listing.Id" />
                    <button type="submit" class="btn-edit">@(Model.Listing.IsDailyRecommended ? "Gunlukten Kaldir" : "Gunun Tavsiyesi Yap")</button>
                </form>
                <form asp-action="ToggleAdminRecommendation" method="post">
                    <input type="hidden" name="id" value="@Model.Listing.Id" />
                    <button type="submit" class="btn-edit">@(Model.Listing.IsAdminRecommended ? "Admin Onerisini Kaldir" : "Admin Onerisi Yap")</button>
                </form>
            }
        </div>

        @if (Model.CanEdit)
        {
            <div class="actions actions-pro">
                <a class="btn-edit" asp-action="Edit" asp-route-id="@Model.Listing.Id">Duzenle</a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Listing.Id" />
                    <button type="submit" class="btn-delete">Sil</button>
                </form>
            </div>
        }
    </div>
</section>

@if (Model.IsLoggedIn)
{
    <section class="panel reveal-on-scroll">
        <h3>Ev ve Satici Puanla</h3>
        @if (Model.CanRate)
        {
            <form asp-action="AddRating" method="post" class="offer-form">
                <input type="hidden" name="ListingId" value="@Model.Listing.Id" />
                <div class="row-2">
                    <div>
                        <label>Ev Puani (1-5)</label>
                        <input type="number" name="ListingScore" min="1" max="5" value="@(Model.MyListingScore ?? 5)" required />
                    </div>
                    <div>
                        <label>Satici Puani (1-5)</label>
                        <input type="number" name="SellerScore" min="1" max="5" value="@(Model.MySellerScore ?? 5)" required />
                    </div>
                </div>
                <div>
                    <label>Yorum (opsiyonel)</label>
                    <textarea name="Comment" maxlength="400">@Model.MyRatingComment</textarea>
                </div>
                <button type="submit" class="btn-glow">Puani Kaydet</button>
            </form>
        }
        else
        {
            <p class="studio-sub">Puan verebilmek icin bu evi kiralamis olmaniz gerekir.</p>
        }
    </section>
}

@section Scripts {
<script>
(() => {
    const gallery = document.querySelector('[data-gallery]');
    if (!gallery) return;

    const slides = Array.from(gallery.querySelectorAll('[data-slide]'));
    const dots = Array.from(gallery.querySelectorAll('[data-gallery-dot]'));
    const prevBtn = gallery.querySelector('[data-gallery-prev]');
    const nextBtn = gallery.querySelector('[data-gallery-next]');
    if (slides.length <= 1) return;

    let index = 0;
    const paint = () => {
        slides.forEach((slide, i) => slide.classList.toggle('active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
    };

    const go = (nextIndex) => {
        const total = slides.length;
        index = (nextIndex + total) % total;
        paint();
    };

    prevBtn?.addEventListener('click', () => go(index - 1));
    nextBtn?.addEventListener('click', () => go(index + 1));

    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const target = Number(dot.getAttribute('data-index') || 0);
            go(target);
        });
    });

    paint();
})();
</script>
}

@if (Model.CanOffer)
{
    <section id="offerBox" class="panel reveal-on-scroll">
        <h3>Bu Ilan Icin Teklif Ver</h3>
        <form asp-action="CreateOffer" method="post" class="offer-form">
            <input type="hidden" name="ListingId" value="@Model.Listing.Id" />
            <div>
                <label>Teklif Tutari (TL)</label>
                <input type="number" name="Amount" min="1000" step="500" required />
            </div>
            <div>
                <label>Notunuz</label>
                <textarea name="Note" placeholder="Orn: 12 aylik pesin odeme yapabilirim"></textarea>
            </div>
            <button type="submit" class="btn-glow">Teklifi Gonder</button>
        </form>
    </section>
}

@if (Model.Offers.Any())
{
    <section class="panel reveal-on-scroll">
        <h3>Gelen Teklifler</h3>
        <div class="offers-table-wrap">
            <table class="lux-table">
                <thead>
                    <tr>
                        <th>Kullanici</th>
                        <th>Tip</th>
                        <th>Tutar</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var o in Model.Offers)
                {
                    <tr>
                        <td>@o.FromUserName</td>
                        <td>@(o.Type == OfferType.RentalRequest ? "Kiralama Talebi" : "Fiyat Teklifi")</td>
                        <td>@o.Amount.ToString("N0") TL</td>
                        <td>
                            @if (o.Type == OfferType.RentalRequest && o.Status == OfferStatus.Accepted)
                            {
                                @:KIRALANDI
                            }
                            else if (o.Status == OfferStatus.Pending)
                            {
                                @:Beklemede
                            }
                            else if (o.Status == OfferStatus.Accepted)
                            {
                                @:Kabul Edildi
                            }
                            else
                            {
                                @:Reddedildi
                            }
                        </td>
                        <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="panel reveal-on-scroll">
    <h3>Yorumlar</h3>
    @if (Model.IsLoggedIn)
    {
        if (Model.CanComment)
        {
            <form asp-action="AddComment" method="post" class="inline-form">
                <input type="hidden" name="listingId" value="@Model.Listing.Id" />
                <input name="content" placeholder="Bu evi kiraladiktan sonraki deneyiminizi yazin..." />
                <button type="submit">Yayinla</button>
            </form>
        }
        else
        {
            <p class="studio-sub">Yorum yalnizca bu ilani kiralayan kullanicilar tarafindan yazilabilir.</p>
        }
    }
    @foreach (var c in Model.Comments)
    {
        <div class="comment-box">
            <strong>@c.AuthorName</strong> <span>@c.CreatedAt.ToLocalTime()</span>
            <p>@c.Content</p>
            @if (Model.IsAdmin)
            {
                <form asp-controller="Admin" asp-action="DeleteComment" method="post">
                    <input type="hidden" name="commentId" value="@c.Id" />
                    <input type="hidden" name="listingId" value="@Model.Listing.Id" />
                    <button type="submit" class="btn-delete">Yorumu Sil</button>
                </form>
            }
        </div>
    }
</section>

<section class="panel reveal-on-scroll">
    <h3>Ev Nerede?</h3>
    <p class="studio-sub">@Model.Listing.District bolgesi harita gorunumu</p>
    <iframe
        class="listing-map-frame"
        src="@mapUrl"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
</section>
